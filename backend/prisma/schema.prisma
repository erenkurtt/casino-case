// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// importFileExtension = "ts" in client for wsl

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Casino {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  games Game[]

  @@map("casinos")
}

model GameType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  games Game[]

  @@map("game_types")
}

model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isoCode   String   @unique @map("iso_code") @db.Char(2)
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users         User[]
  gameCountries GameCountry[]

  @@map("countries")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId    String?  @map("country_id") @db.Uuid
  email        String   @unique @db.VarChar(255)
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  balance      Decimal  @default(20.00) @db.Decimal(18, 2)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  country    Country?           @relation(fields: [countryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  favorites  UserFavoriteGame[]
  spinHistory SpinHistory[]

  @@index([countryId])
  @@map("users")
}

model Game {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId   Int      @unique @map("external_id")

  casinoId     String   @map("casino_id") @db.Uuid
  gameTypeId   String   @map("game_type_id") @db.Uuid

  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(150)
  providerName String   @map("provider_name") @db.VarChar(100)

  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  casino        Casino             @relation(fields: [casinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gameType      GameType           @relation(fields: [gameTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gameCountries GameCountry[]
  favorites     UserFavoriteGame[]
  spinHistory   SpinHistory[]

  @@index([casinoId])
  @@index([gameTypeId])
  @@index([isActive])
  @@map("games")
}

model GameCountry {
  gameId    String   @map("game_id") @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([gameId, countryId])
  @@index([countryId])
  @@map("game_countries")
}

model UserFavoriteGame {
  userId    String   @map("user_id") @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
  @@map("user_favorite_games")
}

model SpinHistory {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  gameId String? @map("game_id") @db.Uuid

  roundId String @unique @map("round_id") @db.VarChar(150)

  betAmount     Decimal @map("bet_amount") @db.Decimal(18, 2)
  winAmount     Decimal @default(0.00) @map("win_amount") @db.Decimal(18, 2)
  netAmount     Decimal @default(0.00) @map("net_amount") @db.Decimal(18, 2)
  balanceBefore Decimal @map("balance_before") @db.Decimal(18, 2)
  balanceAfter  Decimal @map("balance_after") @db.Decimal(18, 2)

  reel1 String @map("reel_1") @db.VarChar(50)
  reel2 String @map("reel_2") @db.VarChar(50)
  reel3 String @map("reel_3") @db.VarChar(50)

  currency   String   @default("COI") @db.Char(3)
  resultData Json?    @map("result_data")
  spunAt     DateTime @default(now()) @map("spun_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([gameId])
  @@index([userId, spunAt])
  @@index([gameId, spunAt])
  @@index([spunAt])
  @@map("spin_history")
}